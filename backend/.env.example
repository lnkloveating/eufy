APP_NAME=eufy Future Product Forecaster
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///data/app.db

# OpenAI-compatible provider. Defaults target DeepSeek's official API.
LLM_API_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_WIKI_NODE_TOKEN=
# Legacy/initial table identifiers are optional. New reports create one table per product.
FEISHU_BITABLE_TABLE_ID=
FEISHU_BITABLE_VIEW_ID=
FEISHU_BITABLE_URL=
PUBLIC_APP_URL=http://localhost:5173
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=6000
STAGE_TIMEOUT_SECONDS=75
WORKFLOW_TIMEOUT_SECONDS=900
