APP_NAME=eufy Future Product Forecaster
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///data/app.db

# OpenAI-compatible provider. Defaults target DeepSeek's official API.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=6000
WORKFLOW_TIMEOUT_SECONDS=900
