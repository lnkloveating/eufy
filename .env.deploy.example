# Copy this file to .env on the deployment server. Never commit the real .env.

# Required: OpenAI-compatible provider credentials used by the backend only.
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Public address used in links generated by the backend.
PUBLIC_APP_URL=http://your-server-ip

# Host port exposed by Docker Compose. Use 80 for direct HTTP access.
APP_PORT=80

# Optional Feishu publishing integration.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_WIKI_NODE_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_BITABLE_VIEW_ID=
FEISHU_BITABLE_URL=
